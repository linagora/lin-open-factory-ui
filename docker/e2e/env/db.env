################################################################################
#                              POSTGRES CONFIGURATION                          #
################################################################################

# PostgreSQL database administrator username
POSTGRES_USER=admin

# PostgreSQL database administrator password
POSTGRES_PASSWORD=password

# Default PostgreSQL database created during container initialization
POSTGRES_DB=postgres

# Database of the UI server, created by ../../init-db/init_ui_db.sh
UI_DATABASE_NAME=lin_open_factory

# PostgreSQL username owning the database of the UI server, which applies the migrations at startup
UI_DATABASE_ADMIN_USER=lin_open_factory_admin

# PostgreSQL password of UI_DATABASE_ADMIN_USER
UI_DATABASE_ADMIN_PASSWORD=password

# PostgreSQL username of the UI server to run, which only reads and writes data
UI_DATABASE_USER=lin_open_factory_user

# PostgreSQL password of UI_DATABASE_USER
UI_DATABASE_PASSWORD=password

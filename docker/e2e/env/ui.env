################################################################################
#                             UI SERVER CONFIGURATION                          #
################################################################################

# Trusts the X-Forwarded-* headers of a reverse proxy, written as JSON: false, true, '"10.0.0.1"' or
# '["10.0.0.1", "10.0.0.0/8"]'
HTTP_TRUST_PROXY=false

# Base URL of the LinID API, replaced by a fake in this environment (see ../fake-api)
API_UPSTREAM=http://api:3000

# Base URL of the Module Federation remote
LIN_PULSAR_UPSTREAM=http://lin-pulsar

# Base URL of LemonLDAP::NG
AUTH_UPSTREAM=http://auth

# Client identifier of the UI server in LemonLDAP::NG
OIDC_CLIENT_ID=lin-open-factory-client

# Scopes requested to LemonLDAP::NG, separated by spaces
OIDC_SCOPE="openid email profile roles"

# Path of the LemonLDAP::NG logout endpoint, as served by this server under /auth
OIDC_LOGOUT_PATH=/auth/oauth2/logout

# Path of the userinfo endpoint on LemonLDAP::NG (AUTH_UPSTREAM), proxied at /auth/me
OIDC_USERINFO_PATH=/oauth2/userinfo

# PKCE method protecting the authorization code, required by LemonLDAP::NG (S256 or plain, chosen from the discovery when empty)
OIDC_PKCE=S256

# The access token is renewed when it expires in less than this number of milliseconds
OIDC_REFRESH_MARGIN_MILLISECONDS=30000

# Path to the server certificate
SERVER_CERT_PATH=/etc/server/certs/server.crt

# Path to the server key
SERVER_KEY_PATH=/etc/server/certs/server.key

# Secret used to sign the session cookie, at least 32 characters
SESSION_SECRET=e2e-only-session-secret-do-not-use-in-production

# Name of the session cookie
SESSION_COOKIE_NAME=lin-open-factory

# Lifetime of the session cookie from the login, in milliseconds
SESSION_MAX_AGE_MILLISECONDS=28800000

# Host of the PostgreSQL database storing the sessions, whose name and credentials are in db.env
SESSION_DATABASE_HOST=db

# Port of the PostgreSQL database storing the sessions
SESSION_DATABASE_PORT=5432

# Uses TLS to reach the database, written as JSON: false, true or '{"rejectUnauthorized": false}'
SESSION_DATABASE_SSL=false

# Maximum number of connections to the database
SESSION_DATABASE_POOL_MAX=10

# A request fails when no connection to the database is available after this number of milliseconds
SESSION_DATABASE_CONNECTION_TIMEOUT_MILLISECONDS=5000

# An unused connection to the database is closed after this number of milliseconds
SESSION_DATABASE_IDLE_TIMEOUT_MILLISECONDS=10000

# Table recording the applied database migrations
SESSION_MIGRATIONS_TABLE=pgmigrations

# Value of the Content-Security-Policy header of index.html, no header if empty
CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-eval'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

# Path to the server configuration file in the container
SERVER_CONFIG_PATH=/app/server-config.json

# Local CA that signs the certificate of the OIDC issuer, trusted by Node.js
NODE_EXTRA_CA_CERTS=/etc/server/certs/ca.crt
